(rule
  (targets grammar_data.ml)
  (deps    parser.cmly)
  (action
    (with-stdout-to %{targets}
       (run lrgrep-embed content=parser.cmly))))

(ocamllex lexer)

(menhir
  (modules parser)
  (flags :standard --table --lalr --cmly))

(library
 (name ocaml_parser)
 (modules lexer parser grammar_data)
  (libraries menhirLib compiler-libs.common))

(rule
  (targets errors.ml coverage.md)
  (deps    parser.cmly errors.lrgrep)
  (action
     (run lrgrep -g parser.cmly -s errors.lrgrep compile -o errors.ml --cover-report coverage.md)))
