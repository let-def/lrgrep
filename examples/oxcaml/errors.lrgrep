rule error_messages = parse error

| /ext: PERCENT . attr_id
  { "Expected extension name after `%`" }

| /attr_id: single_attr_id DOT . attr_id
  { "Expected identifier after `.` in attribute path" }

| /attribute: LBRACKETAT . attr_id attr_payload RBRACKET
  { "Expected attribute identifier after `[@`" }

| [_* /value_description: VAL ext list(attribute) poly_flag . val_ident COLON possibly_poly(core_type) optional_atat_modalities_expr list(post_item_attribute)]
| [_* /class_sig_field: VAL list(attribute) mutable_virtual_flags . LIDENT COLON core_type list(post_item_attribute)]
  { "Expected value name after `val`" }

| /val_extra_ident: LPAREN . operator _*
  { "Expected operator after `(` in value identifier" }

| /operator: DOTOP . LPAREN _*
  /operator: DOTOP . LBRACKET _*
  /operator: DOTOP . LBRACE _*
  { "Expected `(`, `[`, or `{` after `.<op>` operator" }

| /index_mod: SEMI . DOTDOT
  { "Expected `..` after `;` in index operator" }

| [_* /operator: DOTOP LPAREN index_mod . RPAREN _*]
  { "Expected closing `)` in index operator" }

| [_* /operator: DOTOP LBRACKET index_mod . RBRACKET _*]
  { "Expected closing `]` in index operator" }

| [_* /operator: DOTOP LBRACE index_mod . RBRACE _*]
  { "Expected closing `}` in index operator" }

| [_* /val_extra_ident: LPAREN operator . RPAREN]
  { "Expected closing `)` after operator in value identifier" }

| [_* /value_description: VAL ext list(attribute) poly_flag val_ident . COLON possibly_poly(core_type) optional_atat_modalities_expr list(post_item_attribute)]
| /class_sig_field: VAL list(attribute) mutable_virtual_flags LIDENT . COLON core_type list(post_item_attribute)
  { "Expected `:` after value name" }

| /value_description: VAL ext list(attribute) poly_flag val_ident COLON . possibly_poly(core_type) optional_atat_modalities_expr list(post_item_attribute)
  { "Expected type annotation after `:`" }

| /atomic_type: QUOTE . ident
| /type_parameter: type_variance QUOTE . ident list(attribute)
| /alias_type: alias_type AS QUOTE . ident
| /alias_type: alias_type AS LPAREN QUOTE . ident COLON jkind_annotation RPAREN
| /reversed_nonempty_llist(typevar_repr): reversed_nonempty_llist(typevar_repr) LPAREN REPR QUOTE . ident RPAREN
| /reversed_nonempty_llist(typevar): reversed_nonempty_llist(typevar) QUOTE . ident
| /reversed_nonempty_llist(typevar): reversed_nonempty_llist(typevar) LPAREN QUOTE . ident COLON jkind_annotation RPAREN
| [_* /label_let_pattern: nonempty_list(mode_legacy) . LIDENT optional_poly_type_and_modes]
| /reversed_nonempty_llist(typevar_repr): LPAREN REPR QUOTE . ident RPAREN
| /spliceable_type: QUOTE . ident
  { "Expected type variable name after `'`" }

| /newtype: LPAREN . LIDENT COLON jkind_annotation RPAREN
  { "Expected type name after `(`" }

| /optlabel: QUESTION . LIDENT COLON
  { "Expected labeled parameter name after `?`" }

| /optlabel: QUESTION LIDENT . COLON
  { "Expected `:` after optional label name" }

| /atomic_type: LPAREN . reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several) _*
  /atomic_type: LPAREN . QUOTE ident COLON jkind_annotation RPAREN
  /atomic_type: LPAREN . UNDERSCORE COLON jkind_annotation RPAREN
  /atomic_type: LPAREN . TYPE COLON jkind_annotation RPAREN
| /class_self_type: LPAREN . core_type RPAREN
  { "Expected type after `(`" }

| /atomic_type: LPAREN UNDERSCORE COLON . jkind_annotation RPAREN
  /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): UNDERSCORE COLON . jkind_annotation _*
  { "Expected kind annotation after `:` in type parameter" }

| /jkind_desc: LPAREN . jkind_desc RPAREN
  { "Expected kind annotation after `(`" }

| /jkind_desc: KIND_OF . core_type
  { "Expected type after `kind_of_` in kind annotation" }

| /atomic_type: LPAREN TYPE . COLON jkind_annotation RPAREN
| /pattern_gen: constr_longident LPAREN TYPE . newtypes RPAREN simple_pattern
  /pattern_gen: constr_longident LPAREN TYPE . LIDENT COLON jkind_annotation RPAREN simple_pattern
| /method_: _* LIDENT COLON TYPE . newtypes DOT core_type EQUAL seq_expr
  { "Expected type name after `type`" }

| /atomic_type: LPAREN TYPE COLON . jkind_annotation RPAREN
  { "Expected kind annotation after `type:`" }

| /reverse_product_jkind: reverse_product_jkind AMPERSAND . jkind_annotation
| /reverse_product_jkind: jkind_annotation AMPERSAND . jkind_annotation
  { "Expected another kind annotation after `&`" }

| [_* /mk_longident(mod_ext_longident,UIDENT): mod_ext_longident . DOT UIDENT
      /mk_longident(mod_ext_longident,type_trailing_no_hash): mod_ext_longident . DOT type_trailing_no_hash]
| [_* /mk_longident(mod_ext_longident,LIDENT): mod_ext_longident . DOT LIDENT
      /mk_longident(mod_ext_longident,UIDENT): mod_ext_longident . DOT UIDENT]
| [_* /mk_longident(mod_ext_longident,UIDENT): mod_ext_longident . DOT UIDENT
      /mk_longident(mod_ext_longident,type_trailing_hash): mod_ext_longident . DOT type_trailing_hash
      /mk_longident(mod_ext_longident,type_trailing_no_hash): mod_ext_longident . DOT type_trailing_no_hash]
| [_* /mk_longident(mod_longident,LIDENT): mod_longident . DOT LIDENT
      /mk_longident(mod_longident,UIDENT): mod_longident . DOT UIDENT]
  { "Expected `.` to complete path" }

| /mk_longident(mod_ext_longident,UIDENT): mod_ext_longident DOT . UIDENT
| /mk_longident(mod_longident,UIDENT): mod_longident DOT . UIDENT
  { "Expected identifier after `.` in module path" }

| /mod_ext_longident: mod_ext_longident LPAREN . mod_ext_longident RPAREN
  { "Expected module expression after `(`" }

| [_* /mk_longident(mod_ext_longident,UIDENT): mod_ext_longident . DOT UIDENT
      /mod_ext_longident: mod_ext_longident LPAREN mod_ext_longident . RPAREN]
  { "Expected closing `)` after module path" }

| /jkind_desc: jkind_annotation WITH . core_type optional_atat_modalities_expr
  { "Expected type after `with` in kind annotation" }

| /strict_function_or_labeled_tuple_type: LIDENT COLON . LPAREN _*
  /strict_function_or_labeled_tuple_type: LIDENT COLON . tuple_type _*
  /strict_function_or_labeled_tuple_type: LIDENT COLON . nonempty_list(mode_legacy) _*
  /strict_function_or_labeled_tuple_type: LIDENT COLON . atomic_type _*
  { "Expected type after `:` in function type" }

| /atomic_type: LPAREN QUOTE ident COLON . jkind_annotation RPAREN
  /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): QUOTE ident COLON . jkind_annotation _*
| /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): QUOTE ident COLON jkind_annotation COMMA UNDERSCORE COLON . jkind_annotation
| /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): QUOTE ident COLON jkind_annotation COMMA QUOTE ident COLON . jkind_annotation
| /parenthesized_type_parameter: type_variance QUOTE ident list(attribute) COLON . jkind_annotation
| /alias_type: alias_type AS LPAREN QUOTE ident COLON . jkind_annotation RPAREN
| /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several) COMMA QUOTE ident COLON . jkind_annotation
| /reversed_nonempty_llist(typevar): reversed_nonempty_llist(typevar) LPAREN QUOTE ident COLON . jkind_annotation RPAREN
| /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): core_type COMMA QUOTE ident COLON . jkind_annotation
| /newtype: LPAREN LIDENT COLON . jkind_annotation RPAREN
| /pattern_gen: constr_longident LPAREN TYPE LIDENT COLON . jkind_annotation RPAREN simple_pattern
| /atomic_type: LPAREN QUOTE ident COLON . jkind_annotation RPAREN
  /reversed_nonempty_llist(typevar): LPAREN QUOTE ident COLON . jkind_annotation RPAREN
  /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): QUOTE ident COLON . jkind_annotation _*
| /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several):
     UNDERSCORE COLON jkind_annotation COMMA UNDERSCORE COLON . jkind_annotation
| /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several):
     UNDERSCORE COLON jkind_annotation COMMA QUOTE ident COLON . jkind_annotation
  { "Expected kind annotation after `:`" }

| [_* /atomic_type: LPAREN QUOTE ident COLON jkind_annotation . RPAREN
      /jkind_desc: jkind_annotation . MOD nonempty_list(mkrhs(LIDENT))
      /jkind_desc: jkind_annotation . WITH core_type optional_atat_modalities_expr
      /reverse_product_jkind: jkind_annotation . AMPERSAND jkind_annotation
      /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): QUOTE ident COLON jkind_annotation . COMMA _*]
| [_* /atomic_type: LPAREN QUOTE ident COLON jkind_annotation . RPAREN
      /jkind_desc: jkind_annotation . MOD nonempty_list(mkrhs(LIDENT))
      /jkind_desc: jkind_annotation . WITH core_type optional_atat_modalities_expr
      /reverse_product_jkind: jkind_annotation . AMPERSAND jkind_annotation
      /reversed_nonempty_llist(typevar): LPAREN QUOTE ident COLON jkind_annotation . RPAREN
      /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): QUOTE ident COLON jkind_annotation . COMMA _*]
  { "Expected closing `)`, `mod`, `with`, `&`, or `,` after kind annotation" }

| [_* /atomic_type: LPAREN TYPE COLON jkind_annotation . RPAREN
      /jkind_desc: jkind_annotation . MOD nonempty_list(mkrhs(LIDENT))
      /jkind_desc: jkind_annotation . WITH core_type optional_atat_modalities_expr
      /reverse_product_jkind: jkind_annotation . AMPERSAND jkind_annotation]
| [_* /alias_type: alias_type AS LPAREN QUOTE ident COLON jkind_annotation . RPAREN
      /jkind_desc: jkind_annotation . MOD nonempty_list(mkrhs(LIDENT))
      /jkind_desc: jkind_annotation . WITH core_type optional_atat_modalities_expr
      /reverse_product_jkind: jkind_annotation . AMPERSAND jkind_annotation]
| [_* /jkind_desc: jkind_annotation . MOD nonempty_list(mkrhs(LIDENT))
      /jkind_desc: jkind_annotation . WITH core_type optional_atat_modalities_expr
      /reverse_product_jkind: jkind_annotation . AMPERSAND jkind_annotation
      /reversed_nonempty_llist(typevar): reversed_nonempty_llist(typevar) LPAREN QUOTE ident COLON jkind_annotation . RPAREN]
| [_* /jkind_desc: jkind_annotation . MOD nonempty_list(mkrhs(LIDENT))
      /jkind_desc: jkind_annotation . WITH core_type optional_atat_modalities_expr
      /newtype: LPAREN LIDENT COLON jkind_annotation . RPAREN
      /reverse_product_jkind: jkind_annotation . AMPERSAND jkind_annotation]
| [_* /jkind_desc: jkind_annotation . MOD nonempty_list(mkrhs(LIDENT))
      /jkind_desc: jkind_annotation . WITH core_type optional_atat_modalities_expr
      /pattern_gen: constr_longident LPAREN TYPE LIDENT COLON jkind_annotation . RPAREN simple_pattern
      /reverse_product_jkind: jkind_annotation . AMPERSAND jkind_annotation]
| [_* /atomic_type: LPAREN UNDERSCORE COLON jkind_annotation . RPAREN
      /jkind_desc: jkind_annotation . MOD nonempty_list(mkrhs(LIDENT))
      /jkind_desc: jkind_annotation . WITH core_type optional_atat_modalities_expr
      /reverse_product_jkind: jkind_annotation . AMPERSAND jkind_annotation
      /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): UNDERSCORE COLON jkind_annotation . COMMA _*]
  { "Expected closing `)`, `mod`, `with`, or `&` after kind annotation" }

| /jkind_desc: jkind_annotation MOD . nonempty_list(mkrhs(LIDENT))
  { "Expected mode list after `mod` in kind annotation" }

| /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): _* COMMA . core_type
  /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): _* COMMA . QUOTE ident COLON jkind_annotation
  /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): _* COMMA . UNDERSCORE COLON jkind_annotation
  { "Expected type or type variable after `,`" }

| /reversed_nonempty_llist(typevar_repr): _* LPAREN REPR . QUOTE ident RPAREN
  { "Expected type variable after `(repr_`" }

| /delimited_type_supporting_local_open: LESSLBRACKET . core_type RBRACKETGREATER
  { "Expected row field after `[<`" }

| /object_type: LESS . meth_list GREATER
  /object_type: LESS . GREATER
  { "Expected method list or `>` after `<`" }

| /delimited_type_supporting_local_open: LPAREN . core_type RPAREN
  /delimited_type_supporting_local_open: LPAREN . MODULE ext list(attribute) module_type RPAREN
| /atomic_type: LPAREN . reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several) _*
  /atomic_type: LPAREN . QUOTE ident COLON jkind_annotation RPAREN
  /atomic_type: LPAREN . UNDERSCORE COLON jkind_annotation RPAREN
  /atomic_type: LPAREN . TYPE COLON jkind_annotation RPAREN
  /delimited_type_supporting_local_open: LPAREN . core_type RPAREN
  /delimited_type_supporting_local_open: LPAREN . MODULE ext list(attribute) module_type RPAREN
  /reversed_nonempty_llist(typevar): LPAREN . QUOTE ident COLON jkind_annotation RPAREN
  { "Expected type or `module` after `(`" }

| [_* /delimited_type_supporting_local_open: LPAREN MODULE ext list(attribute) . module_type RPAREN]
  { "Expected module type after `module` in parenthesized type" }

| /atat_modalities_expr: ATAT . nonempty_list(modality)
  { "Expected modality list after `@@`" }

| [_* /module_type_atomic: SIG list(attribute) signature . END]
  { "Expected signature item or closing `end` in signature" }

| [_* /type_parameter: type_variance . QUOTE ident list(attribute)
      /type_parameter: type_variance . UNDERSCORE list(attribute)]
  { "Expected type variable or `_` after variance annotation" }

| /parenthesized_type_parameter: type_variance UNDERSCORE list(attribute) COLON . jkind_annotation
| /alias_type: alias_type AS LPAREN UNDERSCORE COLON . jkind_annotation RPAREN
| /reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several): _* COLON . jkind_annotation
  { "Expected kind annotation after `:` in type" }

| [_* /type_parameters: LPAREN reversed_separated_nonempty_llist(COMMA,parenthesized_type_parameter) . RPAREN]
  { "Expected closing `)` in type parameters" }

| [_* /generic_type_declaration(no_nonrec_flag,type_subst_kind): TYPE ext list(attribute) NONREC type_parameters . LIDENT option(jkind_constraint) COLONEQUAL nonempty_type_kind reversed_llist(preceded(CONSTRAINT,constrain)) list(post_item_attribute)
      /generic_type_declaration(nonrec_flag,type_kind): TYPE ext list(attribute) NONREC type_parameters . LIDENT option(jkind_constraint) type_kind reversed_llist(preceded(CONSTRAINT,constrain)) list(post_item_attribute)
      /signature_item: TYPE ext list(attribute) NONREC type_parameters . type_longident PLUSEQ private_flag reversed_bar_llist(extension_constructor_declaration) list(post_item_attribute)]
| [_* /generic_type_declaration(nonrec_flag,type_kind): TYPE ext list(attribute) NONREC type_parameters . LIDENT option(jkind_constraint) type_kind reversed_llist(preceded(CONSTRAINT,constrain)) list(post_item_attribute)
      /structure_item: TYPE ext list(attribute) NONREC type_parameters . type_longident PLUSEQ private_flag reversed_bar_llist(extension_constructor) list(post_item_attribute)]
  { "Expected type identifier after `type nonrec`" }

| /jkind_constraint: COLON . jkind_annotation
  { "Expected type annotation after `:` in type constraint" }

| /type_kind: EQUAL . nonempty_type_kind
  { "Expected type definition after `=`" }

| /nonempty_type_kind: PRIVATE . core_type
  /nonempty_type_kind: PRIVATE . constructor_declarations
  /nonempty_type_kind: PRIVATE . DOTDOT
  /nonempty_type_kind: PRIVATE . LBRACE label_declarations RBRACE
  /nonempty_type_kind: PRIVATE . HASHLBRACE label_declarations RBRACE
  { "Expected type after `private`" }

| /extension: LBRACKETPERCENT . attr_id payload RBRACKET
  { "Expected extension name after `[%`" }

| /fun_expr: UNIQUE . seq_expr
  { "Expected expression after `unique`" }

| [_* /fun_expr: TRY ext list(attribute) . seq_expr _*]
  { "Expected expression after `try`" }

| /reversed_labeled_tuple_body: TILDE . LIDENT _*
  /reversed_labeled_tuple_body: TILDE . LPAREN _*
| /labeled_tuple_pat_element_list(pattern): TILDE . LIDENT _*
  /labeled_tuple_pat_element_list(pattern): TILDE . LPAREN _*
| /labeled_tuple_pat_element_list(pattern_no_exn): TILDE . LIDENT _*
  /labeled_tuple_pat_element_list(pattern_no_exn): TILDE . LPAREN _*
| /labeled_simple_pattern: TILDE . LPAREN label_let_pattern RPAREN
  /labeled_simple_pattern: TILDE . LIDENT
  { "Expected parameter name or `(` after `~`" }

| /reversed_labeled_tuple_body: TILDE LPAREN . LIDENT _*
| /labeled_tuple_pat_element_list(pattern): TILDE LPAREN . LIDENT _*
| /labeled_tuple_pat_element_list(pattern_no_exn): TILDE LPAREN . LIDENT _*
| /labeled_simple_expr: TILDE LPAREN . LIDENT type_constraint RPAREN
  { "Expected parameter name after `~(`" }

| /reversed_labeled_tuple_body: TILDE LPAREN LIDENT . type_constraint _*
| /labeled_simple_expr: TILDE LPAREN LIDENT . type_constraint RPAREN
  { "Expected type constraint (e.g. `: int`) after parameter name" }

| /_* COLONGREATER . core_type _*
  { "Expected type after `:>`" }

| [_* /delimited_type_supporting_local_open: LBRACKETLESS option(BAR) . reversed_separated_nonempty_llist(BAR,row_field) _*]
  { "Expected row field after `[<` or `|`" }

| [_* /delimited_type_supporting_local_open: LBRACKETGREATER option(BAR) . reversed_separated_nonempty_llist(BAR,row_field) RBRACKET]
  { "Expected row field after `[>` or `|`" }

| /delimited_type_supporting_local_open: LBRACKET . tag_field RBRACKET
  /delimited_type_supporting_local_open: LBRACKET . BAR reversed_separated_nonempty_llist(BAR,row_field) RBRACKET
  /delimited_type_supporting_local_open: LBRACKET . row_field BAR reversed_separated_nonempty_llist(BAR,row_field) RBRACKET
  { "Expected row field after `[`" }

| /delimited_type_supporting_local_open: HASHLPAREN . atomic_type STAR reversed_separated_nonempty_llist(STAR,labeled_tuple_typ_element) RPAREN
  /delimited_type_supporting_local_open: HASHLPAREN . LIDENT COLON atomic_type STAR reversed_separated_nonempty_llist(STAR,labeled_tuple_typ_element) RPAREN
  { "Expected type or labeled tuple after `#(`" }

| /delimited_type_supporting_local_open: HASHLPAREN LIDENT COLON . atomic_type STAR reversed_separated_nonempty_llist(STAR,labeled_tuple_typ_element) RPAREN
  { "Expected type after `:` in labeled tuple" }

| /atomic_type: HASH . clty_longident
| /atomic_type: atomic_type HASH . clty_longident
| /atomic_type: LPAREN reversed_separated_nontrivial_llist(COMMA,one_type_parameter_of_several) RPAREN HASH . clty_longident
  { "Expected class type after `#`" }

| /atomic_type: DOLLAR . spliceable_type
  { "Expected spliceable type after `$`" }

| /_* MINUSGREATER . strict_function_or_labeled_tuple_type
  /_* MINUSGREATER . tuple_type _*
  /_* MINUSGREATER . nonempty_list(mode_legacy) _*
| [_* /strict_function_or_labeled_tuple_type: _* at_mode_expr MINUSGREATER nonempty_list(mode_legacy) . tuple_type _*]
  { "Expected type after `->`" }

| /at_mode_expr: AT . nonempty_list(mode)
  { "Expected mode list after `@`" }

| [_* /strict_function_or_labeled_tuple_type: optlabel . LPAREN _*
      /strict_function_or_labeled_tuple_type: optlabel . tuple_type _*
      /strict_function_or_labeled_tuple_type: optlabel . nonempty_list(mode_legacy) _*]
  { "Expected parameter after optional label" }

| /strict_function_or_labeled_tuple_type: optlabel LPAREN LAYOUT . reversed_nonempty_llist(mkrhs(ident)) _*
| /strict_function_or_labeled_tuple_type: nonempty_list(mode_legacy) LPAREN LAYOUT . reversed_nonempty_llist(mkrhs(ident)) _*
| /strict_function_or_labeled_tuple_type: optlabel nonempty_list(mode_legacy) LPAREN LAYOUT . reversed_nonempty_llist(mkrhs(ident)) _*
| /optional_poly_type_and_modes: COLON LAYOUT . reversed_nonempty_llist(mkrhs(ident)) _*
  /possibly_poly(core_type): LAYOUT . reversed_nonempty_llist(mkrhs(ident)) _*
| /strict_function_or_labeled_tuple_type: LPAREN LAYOUT . reversed_nonempty_llist(mkrhs(ident)) _*
  { "Expected type variable list after `layout_`" }

| [_* /strict_function_or_labeled_tuple_type: optlabel LPAREN LAYOUT reversed_nonempty_llist(mkrhs(ident)) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: nonempty_list(mode_legacy) LPAREN LAYOUT reversed_nonempty_llist(mkrhs(ident)) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: nonempty_list(mode_legacy) LPAREN reversed_nonempty_llist(typevar_repr) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: nonempty_list(mode_legacy) LPAREN reversed_nonempty_llist(typevar) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: optlabel LPAREN reversed_nonempty_llist(typevar_repr) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: optlabel LPAREN reversed_nonempty_llist(typevar) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: optlabel nonempty_list(mode_legacy) LPAREN LAYOUT reversed_nonempty_llist(mkrhs(ident)) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: optlabel nonempty_list(mode_legacy) LPAREN reversed_nonempty_llist(typevar_repr) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: optlabel nonempty_list(mode_legacy) LPAREN reversed_nonempty_llist(typevar) . DOT _*]
| [_* /optional_poly_type_and_modes: COLON LAYOUT reversed_nonempty_llist(mkrhs(ident)) . DOT _*
      /possibly_poly(core_type): LAYOUT reversed_nonempty_llist(mkrhs(ident)) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: LPAREN LAYOUT reversed_nonempty_llist(mkrhs(ident)) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: LPAREN reversed_nonempty_llist(typevar_repr) . DOT _*]
| [_* /strict_function_or_labeled_tuple_type: LPAREN reversed_nonempty_llist(typevar) . DOT _*]
| [_* /optional_poly_type_and_modes: COLON LAYOUT reversed_nonempty_llist(mkrhs(ident)) DOT reversed_nonempty_llist(typevar) . DOT tuple_type at_mode_expr
      /possibly_poly(core_type): LAYOUT reversed_nonempty_llist(mkrhs(ident)) DOT reversed_nonempty_llist(typevar) . DOT core_type]
| [_* /optional_poly_type_and_modes: COLON reversed_nonempty_llist(typevar_repr) . DOT tuple_type at_mode_expr
      /possibly_poly(core_type): reversed_nonempty_llist(typevar_repr) . DOT core_type]
| [_* /optional_poly_type_and_modes: COLON reversed_nonempty_llist(typevar) . DOT tuple_type at_mode_expr
      /possibly_poly(core_type): reversed_nonempty_llist(typevar) . DOT core_type]
| [_* /possibly_poly(core_type_no_attr): LAYOUT reversed_nonempty_llist(mkrhs(ident)) . DOT _*]
| [_* /possibly_poly(core_type_no_attr): LAYOUT reversed_nonempty_llist(mkrhs(ident)) DOT reversed_nonempty_llist(typevar) . DOT alias_type]
| [_* /possibly_poly(core_type_no_attr): reversed_nonempty_llist(typevar) . DOT alias_type]
| [_* /generalized_constructor_arguments: COLON reversed_nonempty_llist(typevar) . DOT _*]
| [_* /possibly_poly(core_type): LAYOUT reversed_nonempty_llist(mkrhs(ident)) . DOT _*]
