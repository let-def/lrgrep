(menhir
  (modules parser)
  (flags :standard --table --inspection --cmly))
(ocamllex lexer)

;; [parse_errors.ml] is generated by lrgrep itself, from this grammar's own
;; [parser.cmly], analogously to every other grammar this project has been
;; used on. Bootstrapped with the [lrgrep] binary from the active opam
;; switch (a previously-built, "stage 0" artifact) rather than the in-tree
;; one built from this same source tree: [lrgrep.exe] itself links against
;; this library, so a bareword `(run lrgrep ...)` here would resolve to it
;; via dune's own-workspace binary shadowing and form a dependency cycle
;; (front/parse_errors.ml -> front.cmxa -> lrgrep.exe -> ... -> itself).
;; The absolute path bypasses that shadowing.
;; --cover-all: this grammar is small enough that every reachable error
;; state has a hand-written rule (see parse_errors.lrgrep); keep it that
;; way by failing the build if a future grammar change opens up a new,
;; unhandled error state instead of silently falling back to the generic
;; "syntax error." message.
(rule
  (targets parse_errors.ml)
  (deps    parser.cmly parse_errors.lrgrep)
  (action
    (run %{env:OPAM_SWITCH_PREFIX=/usr}/bin/lrgrep
         -g parser.cmly -s parse_errors.lrgrep
         compile --cover-all -o parse_errors.ml)))

(library
 (name front)
 (public_name lrgrep.internal.front)
 (libraries syntax utils cmon runtime menhirLib))
