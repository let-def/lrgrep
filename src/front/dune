(menhir
  (modules parser)
  (flags :standard --table --inspection --cmly))
(ocamllex lexer)

(rule
  (targets parse_errors.ml.stage2)
  (deps    parser.cmly parse_errors.lrgrep)
  (action
    (run lrgrep -g parser.cmly -s parse_errors.lrgrep
                compile --cover-all -o parse_errors.ml.stage2)))

(rule
 (alias bootstrap)
 (action (cmp parse_errors.ml parse_errors.ml.stage2)))

(library
 (name front)
 (public_name lrgrep.internal.front)
 (libraries syntax utils cmon runtime menhirLib))
