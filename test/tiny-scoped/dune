(menhir
  (modules parser)
  (flags :standard --inspection --table --cmly))

;; Note: unlike [test/tiny] we do NOT pass lrgrep's [--cover-all] flag here: the
;; point of this test is the runtime behaviour of rule-definition scopes, and we
;; want the build (i.e. the lrgrep compilation) to succeed so that the failure,
;; if any, comes from running the driver rather than from the code generation
;; step.

(rule
  (targets parse_errors.ml)
  (deps    parser.cmly parse_errors.lrgrep)
  (action
     (run lrgrep -g parser.cmly -s parse_errors.lrgrep
          compile -o parse_errors.ml)))

(executable
 (name main)
 (libraries menhirLib lrgrep.runtime))

(rule (alias runtest) (action (run ./main.exe)))
