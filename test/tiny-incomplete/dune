(menhir
  (modules parser)
  (flags :standard --inspection --table --cmly))

;; NOTE: This is the same rule as in [test/tiny], in particular it uses
;; lrgrep's [--cover-all] flag, which exits with a failure when the coverage of
;; error situations is not exhaustive. Because [parse_errors.lrgrep] here is
;; missing the [OPAREN ; [chars]] rule, this rule is expected to FAIL the build,
;; demonstrating that the exhaustivity check catches the missing case.

(rule
  (targets parse_errors.ml)
  (deps    parser.cmly parse_errors.lrgrep)
  (action
     (run lrgrep -g parser.cmly -s parse_errors.lrgrep
          compile --cover-all -o parse_errors.ml)))

(executable
 (name main)
 (libraries menhirLib lrgrep.runtime))
